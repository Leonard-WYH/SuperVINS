set(ONNXRUNTIME_ROOTDIR "$ENV{ONNXRUNTIME_ROOTDIR}" CACHE PATH "ONNX Runtime C++ SDK root")
if(NOT ONNXRUNTIME_ROOTDIR)
  set(ONNXRUNTIME_ROOTDIR "/opt/onnxruntime" CACHE PATH "ONNX Runtime C++ SDK root" FORCE)
endif()
find_path(ONNXRUNTIME_INCLUDE_DIR onnxruntime_cxx_api.h
  PATHS "${ONNXRUNTIME_ROOTDIR}/include" NO_DEFAULT_PATH REQUIRED)
find_library(ONNXRUNTIME_LIBRARY onnxruntime
  PATHS "${ONNXRUNTIME_ROOTDIR}/lib" NO_DEFAULT_PATH REQUIRED)
include_directories(${ONNXRUNTIME_INCLUDE_DIR})
message(STATUS "ONNX Runtime: ${ONNXRUNTIME_LIBRARY}")
