set(ONNXRUNTIME_ROOTDIR "$ENV{ONNXRUNTIME_ROOTDIR}" CACHE PATH "ONNX Runtime C++ SDK root")
get_filename_component(SUPERVINS_WORKSPACE "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT ONNXRUNTIME_ROOTDIR)
  set(ONNXRUNTIME_ROOTDIR "${SUPERVINS_WORKSPACE}/deps/onnxruntime-1.23.2" CACHE PATH "ONNX Runtime C++ SDK root" FORCE)
elseif(NOT IS_ABSOLUTE "${ONNXRUNTIME_ROOTDIR}")
  get_filename_component(ONNXRUNTIME_ROOTDIR "${SUPERVINS_WORKSPACE}/${ONNXRUNTIME_ROOTDIR}" ABSOLUTE)
endif()
find_path(ONNXRUNTIME_INCLUDE_DIR onnxruntime_cxx_api.h
  PATHS "${ONNXRUNTIME_ROOTDIR}/include" NO_DEFAULT_PATH)
find_library(ONNXRUNTIME_LIBRARY onnxruntime
  PATHS "${ONNXRUNTIME_ROOTDIR}/lib" NO_DEFAULT_PATH)
if(NOT ONNXRUNTIME_INCLUDE_DIR OR NOT ONNXRUNTIME_LIBRARY)
  message(FATAL_ERROR "ONNX Runtime SDK missing: ${ONNXRUNTIME_ROOTDIR}. Run scripts/setup_ort.sh first.")
endif()
include_directories(${ONNXRUNTIME_INCLUDE_DIR})
message(STATUS "ONNX Runtime: ${ONNXRUNTIME_LIBRARY}")
